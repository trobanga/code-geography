+/// The last name of a path: `f` in `a::b::f` and in `a::f::<T>`.
+fn name_token(node: Ts) -> Ts {
+    match node.kind() {
+        "scoped_identifier" => node.child_by_field_name("name").unwrap_or(node),
+        "generic_function" => node.child_by_field_name("function").map_or(node, name_token),
+        _ => node,
+    }
+}
+
 fn starts_uppercase(name: &str) -> bool {
     name.chars().next().is_some_and(char::is_uppercase)
 }
